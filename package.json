{
  "name": "nutriaxpro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:patient": "npm --prefix apps/patient run dev",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build && npm --prefix apps/patient run build",
    "lint": "npm --prefix apps/web run lint",
    "type-check": "npm --prefix apps/web run type-check"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0"
}
